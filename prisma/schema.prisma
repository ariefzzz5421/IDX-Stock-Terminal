// IDX Terminal — Prisma schema
// Datasource URL is read from DATABASE_URL via prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../lib/db/generated"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Auth & profile
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  profile   Profile?
  watchlist Watchlist[]
  streamPosts StreamPost[]
  streamComments StreamComment[]
  streamLikes StreamLike[]
  researchNotifications ResearchNotification[]

  @@map("users")
}

model Profile {
  userId      String   @id @map("user_id")
  displayName String?  @map("display_name")
  bio         String?
  avatarUrl   String?  @map("avatar_url")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

// ---------------------------------------------------------------------------
// Market data
// ---------------------------------------------------------------------------

model Watchlist {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  stockCode String   @map("stock_code")
  addedAt   DateTime @default(now()) @map("added_at")
  sortOrder Int      @default(0) @map("sort_order")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockCode], references: [code], onDelete: Cascade)

  @@unique([userId, stockCode])
  @@index([userId, sortOrder])
  @@map("watchlists")
}

/// Latest snapshot per ticker. Prices are IDR and always whole rupiah on IDX,
/// so Float (f64) holds them exactly; it keeps values JSON-serialisable
/// across the server/client boundary, unlike Prisma's Decimal/BigInt.
model Stock {
  code          String   @id
  name          String
  isListed      Boolean  @default(true) @map("is_listed")
  sector        String?
  /// Rupiah. Used to rank the board when turnover isn't known yet.
  marketCap     Float?   @map("market_cap")
  /// Overrides the generated monogram tile when a real logo is available.
  logoUrl       String?  @map("logo_url")
  lastPrice     Float?   @map("last_price")
  prevClose     Float?   @map("prev_close")
  lastChangePct Float?   @map("last_change_pct")
  lastVolume    Float?   @map("last_volume")
  lastValue     Float?   @map("last_value")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  watchlists   Watchlist[]
  priceHistory PriceHistory[]
  intelligenceTickers IntelligenceTicker[]

  @@index([lastChangePct])
  @@index([marketCap])
  @@map("stocks")
}

model PriceHistory {
  id        Int      @id @default(autoincrement())
  stockCode String   @map("stock_code")
  interval  String   @default("1m")
  timestamp DateTime
  open      Float
  high      Float
  low       Float
  close     Float
  volume    Float

  stock Stock @relation(fields: [stockCode], references: [code], onDelete: Cascade)

  @@unique([stockCode, interval, timestamp])
  @@index([stockCode, interval, timestamp(sort: Desc)])
  @@map("price_history")
}

// ---------------------------------------------------------------------------
// News
// ---------------------------------------------------------------------------

model News {
  id          String   @id @default(cuid())
  title       String
  summary     String?
  source      String
  url         String   @unique
  publishedAt DateTime @map("published_at")
  /// JSON-encoded array of ticker codes. SQLite has no native scalar list
  /// type (Postgres-only), so this is stored as text and encoded/decoded
  /// at the call site.
  relatedCodes String  @default("[]") @map("related_codes")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([publishedAt(sort: Desc)])
  @@map("news")
}

model StreamPost {
  id String @id @default(cuid())
  authorId String @map("author_id")
  kind String @default("status")
  body String
  tickers String @default("[]")
  hasPhoto Boolean @default(false) @map("has_photo")
  photoData String? @map("photo_data")
  createdAt DateTime @default(now()) @map("created_at")
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments StreamComment[]
  likes StreamLike[]
  @@index([createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
  @@map("stream_posts")
}

model StreamComment {
  id String @id @default(cuid())
  postId String @map("post_id")
  authorId String @map("author_id")
  body String
  createdAt DateTime @default(now()) @map("created_at")
  post StreamPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)
  @@index([postId, createdAt(sort: Desc)])
  @@map("stream_comments")
}

model StreamLike {
  postId String @map("post_id")
  userId String @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post StreamPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([postId, userId])
  @@index([userId])
  @@map("stream_likes")
}

model IntelligenceEvent {
  id String @id
  identity String @unique
  category String
  title String
  priority String
  status String
  direction String
  score Int
  summary String
  firstSeenAt DateTime @default(now())
  publishedAt DateTime?
  effectiveAt DateTime?
  lastChangedAt DateTime @default(now())
  lastCheckedAt DateTime @default(now())
  latestVersion Int @default(0)
  versions IntelligenceEventVersion[]
  sources IntelligenceSource[]
  tickers IntelligenceTicker[]
  @@index([publishedAt(sort: Desc)])
  @@index([category, priority, status])
  @@map("intelligence_events")
}

model IntelligenceEventVersion {
  id String @id @default(cuid())
  eventId String
  eventVersion Int
  previousVersionId String?
  contentFingerprint String
  changeType String
  sourceUrl String
  sourceDocumentId String
  status String
  priority String
  direction String
  score Int
  title String
  summary String
  factsJson String
  analysisJson String
  announcementAt DateTime?
  effectiveAt DateTime?
  publishedAt DateTime @default(now())
  createdAt DateTime @default(now())
  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sources IntelligenceSource[]
  notifications ResearchNotification[]
  @@unique([eventId, eventVersion])
  @@index([publishedAt(sort: Desc)])
  @@map("intelligence_event_versions")
}

model IntelligenceSource {
  id String @id @default(cuid())
  sourceDocumentId String @unique
  eventId String?
  versionId String?
  adapter String
  sourceUrl String
  host String
  title String
  status String
  contentFingerprint String?
  excerpt String?
  publishedAt DateTime?
  fetchedAt DateTime @default(now())
  lastCheckedAt DateTime @default(now())
  error String?
  event IntelligenceEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  version IntelligenceEventVersion? @relation(fields: [versionId], references: [id], onDelete: SetNull)
  @@index([adapter, publishedAt(sort: Desc)])
  @@map("intelligence_sources")
}

model IntelligenceTicker {
  eventId String
  stockCode String
  securityCode String
  securityType String @default("STOCK")
  event IntelligenceEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  stock Stock @relation(fields: [stockCode], references: [code], onDelete: Cascade)
  @@id([eventId, securityCode])
  @@index([stockCode])
  @@map("intelligence_tickers")
}

model ResearchRun {
  id String @id @default(cuid())
  slot String @unique
  status String
  dryRun Boolean @default(false)
  startedAt DateTime @default(now())
  endedAt DateTime?
  leaseExpiresAt DateTime
  cursorJson String @default("{}")
  sourcesChecked Int @default(0)
  newEvents Int @default(0)
  updatedEvents Int @default(0)
  failedAdapters Int @default(0)
  aiInputTokens Int @default(0)
  aiOutputTokens Int @default(0)
  errorLog String @default("[]")
  @@index([startedAt(sort: Desc)])
  @@index([status, startedAt(sort: Desc)])
  @@map("research_runs")
}

model ResearchNotification {
  id String @id @default(cuid())
  userId String
  versionId String
  createdAt DateTime @default(now())
  readAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  version IntelligenceEventVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  @@unique([userId, versionId])
  @@index([userId, readAt])
  @@map("research_notifications")
}
