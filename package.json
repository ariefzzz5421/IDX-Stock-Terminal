{
  "name": "idx-terminal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/postinstall-db.mjs",
    "dev": "next dev",
    "build": "node scripts/build.mjs",
    "start": "next start",
    "lint": "eslint",
    "test:intelligence": "node --import tsx --test tests/intelligence.test.ts",
    "postinstall": "prisma generate && prisma generate --config prisma.supabase.config.ts && node scripts/postinstall-db.mjs",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:supabase:deploy": "prisma migrate deploy --config prisma.supabase.config.ts",
    "db:supabase:seed": "tsx prisma/seed.ts",
    "db:supabase:setup": "npm run db:supabase:deploy && npm run db:supabase:seed",
    "catalog:refresh": "tsx scripts/fetch-idx-listing.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "logos:sync": "tsx scripts/logos-sync.ts",
    "logos:check": "tsx scripts/logos-check.ts"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cheerio": "^1.2.0",
    "fast-xml-parser": "^5.10.1",
    "iron-session": "^8.0.4",
    "leaflet": "^1.9.4",
    "lightweight-charts": "^5.2.0",
    "lucide-react": "^1.30.0",
    "next": "^16.3.7",
    "openai": "^7.28.0",
    "pdf-parse": "^1.1.1",
    "pg": "^8.23.0",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "ws": "^8.21.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.7",
    "fflate": "^0.8.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.10",
    "typescript": "^5"
  }
}
