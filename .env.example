# ---------------------------------------------------------------------------
# Database — local PostgreSQL
# ---------------------------------------------------------------------------
# If you use the bundled docker-compose.yml, this value works as-is.
# If you use a PostgreSQL you installed yourself, swap in your own
# user/password/port.
DATABASE_URL="postgresql://idx:idx@localhost:5432/idx_terminal?schema=public"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Cookie encryption key for iron-session. MUST be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-string-of-at-least-32-chars"

# Leave false and the terminal opens straight onto the dashboard, using a
# shared "guest" account for the watchlist and profile — no login step.
# Set to true to require an account before anything is visible.
AUTH_REQUIRED="false"

# ---------------------------------------------------------------------------
# Market data provider
# ---------------------------------------------------------------------------
# Which adapter lib/market-data/ should use: mock | goapi | itick | invezgo
# "mock" needs no API key and generates plausible synthetic IDX ticks — use it
# to run the terminal end-to-end without signing up for anything.
MARKET_DATA_PROVIDER="mock"

# GoAPI.io — https://goapi.io  (REST snapshots, free tier)
GOAPI_KEY=""

# iTick — https://itick.org  (WebSocket streaming, region=ID, free tier)
ITICK_TOKEN=""

# Invezgo — https://invezgo.com  (REST, IDX prices + broker summary + foreign flow)
INVEZGO_KEY=""

# ---------------------------------------------------------------------------
# Realtime / background jobs
# ---------------------------------------------------------------------------
# Port for the internal WebSocket relay server.
WS_PORT="4001"
# Public URL the browser connects to. Keep in sync with WS_PORT.
NEXT_PUBLIC_WS_URL="ws://localhost:4001"

# How often (ms) to poll the provider for fresh quotes.
QUOTE_POLL_INTERVAL_MS="5000"
# How often (ms) to re-fetch the news RSS sources.
NEWS_POLL_INTERVAL_MS="120000"

# ---------------------------------------------------------------------------
# Pump detector thresholds
# ---------------------------------------------------------------------------
# Fire stock:pump when price rises this many % within PUMP_WINDOW_MINUTES...
PUMP_PRICE_CHANGE_PCT="5"
PUMP_WINDOW_MINUTES="5"
# ...OR when volume exceeds this multiple of its recent average.
PUMP_VOLUME_MULTIPLIER="3"
# Don't re-alert the same ticker within this many minutes.
PUMP_COOLDOWN_MINUTES="15"
