[Unit]
Description=IDX hourly Volume (:00 from 10 WIB) and ARA/ARB (:10), active BEI sessions only

[Timer]
# systemd timezone-aware calendar. Backend skips lunch, holidays and closed markets.
OnCalendar=Mon..Fri *-*-* 10..15:00:00 Asia/Jakarta
OnCalendar=Mon..Fri *-*-* 10..15:10:00 Asia/Jakarta
AccuracySec=10s
Persistent=false
Unit=idx-market-alert.service

[Install]
WantedBy=timers.target
